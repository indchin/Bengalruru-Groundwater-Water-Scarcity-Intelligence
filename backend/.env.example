# Copy this file to .env and adjust for your environment.

PORT=4000
NODE_ENV=development

# SQLite file path. For Docker/production, point this at a mounted volume
# so the data survives container restarts (see ../docker-compose.yml).
DB_PATH=./data/app.db

# Required in the X-Api-Key header for POST /api/admin/*. Generate a real
# random value for anything beyond local dev, e.g.: openssl rand -hex 32
ADMIN_API_KEY=dev-only-change-me

# Comma-free single origin, or "*" for local dev. Set this to your actual
# frontend origin in production (e.g. https://bengaluru-water.example.com).
CORS_ORIGIN=*

# Standard cron syntax: minute hour day month weekday. Default = 3am daily.
REFRESH_CRON=0 3 * * *

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
